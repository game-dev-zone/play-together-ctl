// 基本防護（pt new 產生）：限流。通常不需要修改；數字可以依遊戲調整。
//
// - 每個 IP、每位玩家（token）各自限流，超過回 429 rate_limited。玩聚平台的限流擋不到你的伺服器，要自己做。
// - 請求太大回 413 too_large、GET /healthz 回 {"status":"ok"}（在 main.mjs）。
//
// IP 預設取連線的來源位址。放在反向代理（Caddy、nginx、Cloudflare Tunnel）後面時，設 TRUST_PROXY=<代理層數>：
// 每層代理會在 X-Forwarded-For 後面加上它看到的來源，所以取從右邊數第 N 個（例如只有 Caddy 是 1；Cloudflare → Caddy 是 2）。
// 沒有代理時不要設；層數設太多，玩家可以自己偽造 IP，設太少，所有人會被當成同一個 IP。

// 令牌桶：每秒補充 rate 次、最多累積 burst 次；每個 key 一個桶，太久沒用的桶會清掉。
export function createLimiter(rate, burst) {
  const buckets = new Map();
  let swept = Date.now();
  return (key) => {
    const now = Date.now();
    if (now - swept > 60_000) {
      for (const [k, b] of buckets) if (now - b.at > 600_000) buckets.delete(k);
      swept = now;
    }
    let b = buckets.get(key);
    if (!b) {
      b = { tokens: burst, at: now };
      buckets.set(key, b);
    }
    b.tokens = Math.min(burst, b.tokens + ((now - b.at) / 1000) * rate);
    b.at = now;
    if (b.tokens < 1) return false;
    b.tokens -= 1;
    return true;
  };
}

// 前端每 0.5 秒輪詢一次狀態，再加上玩家操作（例如連打）
export const actionPerPlayer = createLimiter(20, 40); // 每位玩家的 /action
export const requestsPerIP = createLimiter(60, 120); // 每個 IP 的所有 API（同一個網路可能有好幾位玩家）
export const joinsPerIP = createLimiter(0.5, 10); // 每個 IP 的 /join（重新整理才會呼叫；每 2 秒補 1 次）

const trustProxy = Number.parseInt(process.env.TRUST_PROXY || '0', 10) || 0; // 信任幾層反向代理；0 表示不信任 X-Forwarded-For

export function clientIP(req) {
  if (trustProxy > 0) {
    const xff = req.headers['x-forwarded-for'];
    const parts = typeof xff === 'string' ? xff.split(',') : [];
    if (parts.length >= trustProxy) return parts[parts.length - trustProxy].trim();
  }
  return req.socket.remoteAddress || '';
}

// [[.Name]] 的遊戲伺服器（pt new 從範本「一起按」產生，Node.js 版）：這個檔案只有遊戲規則。
//
// 和玩聚平台的接口（兌換啟動碼、座位與斷線重連、踢人、重新開始、關房、回報一局、限流、請求大小、跨來源、/healthz）
// 都在玩聚伺服器 SDK 的 createGameServer（playtogether-server.mjs）；平台接口有新增或修正時，
// 在專案根目錄執行 pt sdk update 就會更新，不用改這個檔案。只用 Node 內建模組，不需要 npm install。
//
// 本機開發：在專案根目錄執行 pt dev（本機假平台，不需要連玩聚）；改完用 pt verify server 驗證和玩聚的接口。
// 接上玩聚（正式部署）：
//   PT_API_URL=（平台網址） PT_KEY_ID=（伺服器金鑰 ID） PT_KEY_FILE=../keys/server.key \
//   ALLOW_ORIGINS='https://*.games.（平台網域）' ADDR=0.0.0.0:8090 node main.mjs
// 選填：SEAT_HOLD（離線多久讓出座位，預設 60s）、ROOM_SYNC（多久向玩聚查一次房間，預設 10s）、
// TRUST_PROXY=<代理層數>（在反向代理後面時，限流改用 X-Forwarded-For 的 IP）。
//
// 規則：下面的函式都要是同步的、只做記憶體內的運算（不能 await 平台、網路或檔案）。
// 回報一局用 room.startRound、room.endRound（套件在背景送出）。
import { readFileSync, statSync } from 'node:fs';
import { extname, join as joinPath, normalize } from 'node:path';
import { createGameServer, platformFromEnv } from './playtogether-server.mjs';

const ROUND_MS = 10_000;
const env = (k, d) => process.env[k] || d;

// game 是一個房間的遊戲狀態（「一起按」：10 秒內比誰按得多）。換成你的玩法時改這裡。
function newGame() {
  return {
    taps: new Map(), // 玩家 ID → 按了幾下
    endsAt: 0, // 進行中的一局何時結束；0 表示沒有在玩
    winner: '',
    playing(now) { return this.endsAt > 0 && now < this.endsAt; },
    // 離線太久的人能不能讓出座位：一局進行中先保留，讓他有機會回來
    canFree() { return !this.endsAt; },
    // 玩家讓出座位或被房主踢出
    leave(playerId) { this.taps.delete(playerId); },
    // 房間結束（房主重新開始、關房）。進行中的一局由套件回報「中止」，這裡只清理
    close() { this.endsAt = 0; },
    // 給某一位玩家看的完整狀態（加入、重新連線、每次操作後都回這個）。只放這位玩家可以看的資料
    view(room, viewer) {
      const players = room.seats().map((s) => ({ id: s.playerId, name: s.name, taps: this.taps.get(s.playerId) || 0, online: s.online }))
        .sort((a, b) => b.taps - a.taps || a.name.localeCompare(b.name));
      const now = room.now();
      const left = this.playing(now) ? (this.endsAt - now) / 1000 : 0;
      return { me: viewer, players, playing: left > 0, secondsLeft: left, winner: this.winner };
    },
    // 每 200ms 呼叫一次：時間到就結束這一局、判定勝負
    tick(room) {
      if (!this.endsAt || room.now() < this.endsAt) return;
      let best = 0;
      for (const s of room.seats()) {
        const n = this.taps.get(s.playerId) || 0;
        if (n > best) { best = n; this.winner = s.name; }
      }
      this.endsAt = 0;
      room.endRound('completed');
    },
  };
}

// 玩家送來的操作（POST /action 的 action，data 是選用的 JSON）。玩家只能送「操作」，分數與勝負由伺服器決定。
// 不認得的 action（例如前端每 0.5 秒輪詢用的 "state"）直接 return，套件會回這位玩家的 view。
function onAction(room, seat, g, action) {
  const now = room.now();
  if (action === 'start' && !g.endsAt) {
    const ids = room.seats().map((s) => s.playerId);
    for (const id of ids) g.taps.set(id, 0);
    room.startRound(ids);
    g.winner = '';
    g.endsAt = now + ROUND_MS;
  }
  if (action === 'tap' && g.playing(now)) g.taps.set(seat.playerId, (g.taps.get(seat.playerId) || 0) + 1);
}

const platform = platformFromEnv();
const server = createGameServer({ platform, newGame, onAction });
server.start();

// 本機開發時也直接提供前端（同一個來源）；上傳到玩聚託管後，前端由玩聚提供、只呼叫 API
const webDir = env('WEB_DIR', '../web');
const TYPES = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.png': 'image/png', '.jpg': 'image/jpeg', '.wasm': 'application/wasm' };
function serveStatic(req, res) {
  if (req.method !== 'GET') { res.writeHead(405); return res.end(); }
  try {
    const path = normalize(decodeURIComponent((req.url || '/').split('?')[0])).replace(/^(\.\.[/\\])+/, '');
    let file = joinPath(webDir, path === '/' ? 'index.html' : path);
    if (statSync(file).isDirectory()) file = joinPath(file, 'index.html');
    res.writeHead(200, { 'Content-Type': TYPES[extname(file)] || 'application/octet-stream' });
    return res.end(readFileSync(file));
  } catch {
    res.writeHead(404); return res.end('not found');
  }
}

const [host, port] = env('ADDR', '127.0.0.1:8090').split(':');
const http = server.listen(Number(port), host, serveStatic);
http.on('listening', () => console.log(`[[.Name]]：http://${host}:${port}（平台：${process.env.PT_MOCK === '1' ? '模擬模式' : env('PT_API_URL', '')}）`));
for (const sig of ['SIGINT', 'SIGTERM']) {
  process.on(sig, async () => {
    http.close();
    await server.close(5_000); // 送完還沒送出的一局回報
    process.exit(0);
  });
}

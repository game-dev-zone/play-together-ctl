package main

// 斷線重連骨架（pt new 產生）：管「連線的生命週期」，不管遊戲規則。通常不需要修改。
//
//   - 座位綁定玩聚的玩家 ID：重新整理、換裝置、網路恢復後，用新的啟動碼回到原座位。
//   - 重新加入時換一個新 token，舊 token 立即失效（回 401 session_expired），同一個人不能兩個分頁同時操作。
//   - 多久沒收到請求算離線；離線超過 SEAT_HOLD 而且遊戲同意（canFree）時讓出座位。
//   - 每 ROOM_SYNC 向玩聚查一次房間：被踢的人立即失效；房主重新開始（局數增加）或房間關閉時結束這個房間。
//   - 連續查不到玩聚超過 6 次查詢的時間（預設 60 秒）：拒絕新加入（已在房間的人繼續玩），不無限期放行舊狀態。
//
// 遊戲規則在 main.go，透過這幾個函式接上：newGame、(*game).view、(*game).canFree、(*game).leave、(*game).abort。
// 平台的分工見玩聚開發者文件站 /docs/reconnect：平台管誰能進房間，遊戲伺服器管座位與遊戲狀態。

import (
	"context"
	"crypto/rand"
	"encoding/hex"
	"errors"
	"log"
	"os"
	"sync"
	"time"

	playtogether "github.com/Yanghsuanming/play-together/sdk-go"
)

var (
	offlineAfter       = 5 * time.Second                          // 多久沒收到請求算離線（前端每 0.5 秒輪詢）
	seatHold           = envDuration("SEAT_HOLD", 60*time.Second) // 離線多久讓出座位
	roomSync           = envDuration("ROOM_SYNC", 10*time.Second) // 多久向玩聚查一次房間
	platformStaleAfter = 6 * roomSync                             // 連續查不到玩聚多久後拒絕新加入
	idleRoom           = 30 * time.Minute                         // 沒有人的房間多久後清掉
)

var (
	errStaleEpoch     = errors.New("stale_epoch")          // 房主已重新開始，這是舊局的啟動碼
	errPlatformStale  = errors.New("platform_unavailable") // 一段時間查不到玩聚，暫停新加入
	errSessionExpired = errors.New("session_expired")      // token 已失效：重新整理頁面拿新的啟動碼
)

// seat 是一位玩家在這個房間的座位。
type seat struct {
	PlayerID string
	Name     string
	token    string
	lastSeen time.Time
}

func (s *seat) online(now time.Time) bool { return now.Sub(s.lastSeen) < offlineAfter }

type room struct {
	id      string
	epoch   int
	seats   map[string]*seat // 玩家 ID → 座位
	game    *game
	emptyAt time.Time // 最後一個人離開的時間
}

type hub struct {
	pt     *playtogether.Client
	mu     sync.Mutex
	rooms  map[string]*room
	tokens map[string]*tokenRef
	// 向玩聚查房間開始失敗的時間；零值表示最近一次成功
	syncFailingSince time.Time
	now              func() time.Time
}

type tokenRef struct{ roomID, playerID string }

func newHub(pt *playtogether.Client) *hub {
	return &hub{pt: pt, rooms: map[string]*room{}, tokens: map[string]*tokenRef{}, now: time.Now}
}

func newToken() string {
	b := make([]byte, 16)
	_, _ = rand.Read(b)
	return hex.EncodeToString(b)
}

// joined 是 join 的結果：在同一把鎖裡產生，不會拿到別的請求換掉的 token。
type joined struct {
	Token    string         `json:"token"`
	PlayerID string         `json:"playerId"`
	Name     string         `json:"name"`
	State    map[string]any `json:"state"` // 這位玩家看得到的完整狀態
}

// join：兌換一次性啟動碼，把玩家放回原座位（或給新座位），回傳新的連線 token 與目前狀態。
func (h *hub) join(ctx context.Context, code string) (*joined, error) {
	h.mu.Lock()
	stale := !h.syncFailingSince.IsZero() && h.now().Sub(h.syncFailingSince) > platformStaleAfter
	h.mu.Unlock()
	if stale {
		return nil, errPlatformStale
	}
	ex, err := h.pt.ExchangeLaunchCode(ctx, code) // 不在鎖裡呼叫平台
	if err != nil {
		return nil, err
	}
	h.mu.Lock()
	defer h.mu.Unlock()
	r := h.rooms[ex.RoomID]
	if r != nil && ex.Epoch < r.epoch {
		return nil, errStaleEpoch
	}
	if r == nil || ex.Epoch > r.epoch {
		if r != nil {
			h.endRoom(r) // 房主在平台按了「重新開始」：舊局結束，所有舊連線失效
		}
		r = &room{id: ex.RoomID, epoch: ex.Epoch, seats: map[string]*seat{}, game: newGame()}
		h.rooms[r.id] = r
	}
	s := r.seats[ex.PlayerID]
	if s == nil {
		s = &seat{PlayerID: ex.PlayerID, Name: ex.Name}
		r.seats[s.PlayerID] = s
	}
	delete(h.tokens, s.token) // 舊分頁、舊裝置的連線立即失效
	s.token = newToken()
	s.lastSeen = h.now()
	h.tokens[s.token] = &tokenRef{r.id, s.PlayerID}
	return &joined{Token: s.token, PlayerID: s.PlayerID, Name: s.Name, State: r.game.view(r, s.PlayerID, h.now())}, nil
}

// lookup：用 token 找到房間與座位，並記錄「剛剛還在」。呼叫前要持有 h.mu。
func (h *hub) lookup(token string) (*room, *seat, error) {
	t := h.tokens[token]
	if t == nil {
		return nil, nil, errSessionExpired
	}
	r := h.rooms[t.roomID]
	if r == nil {
		return nil, nil, errSessionExpired
	}
	s := r.seats[t.playerID]
	if s == nil || s.token != token {
		return nil, nil, errSessionExpired
	}
	s.lastSeen = h.now()
	return r, s, nil
}

// removeSeat 讓出座位並讓 token 失效。呼叫前要持有 h.mu。
func (h *hub) removeSeat(r *room, playerID string) {
	s := r.seats[playerID]
	if s == nil {
		return
	}
	delete(h.tokens, s.token)
	delete(r.seats, playerID)
	r.game.leave(playerID)
	if len(r.seats) == 0 {
		r.emptyAt = h.now()
	}
}

// endRoom 結束房間：所有連線失效；有進行中的一局就回報中止。呼叫前要持有 h.mu。
func (h *hub) endRoom(r *room) {
	for _, s := range r.seats {
		delete(h.tokens, s.token)
	}
	delete(h.rooms, r.id)
	if roundID := r.game.abort(); roundID != "" {
		roomID, epoch := r.id, r.epoch
		go func() {
			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
			defer cancel()
			if err := h.pt.ReportRoundEnd(ctx, roomID, epoch, roundID, playtogether.RoundAborted); err != nil {
				log.Printf("回報一局中止失敗（不影響遊戲）：%v", err)
			}
		}()
	}
}

// sweep：離線太久而且遊戲同意的人讓出座位；沒有人的房間過一段時間清掉。每秒執行。
func (h *hub) sweep() {
	h.mu.Lock()
	defer h.mu.Unlock()
	now := h.now()
	for _, r := range h.rooms {
		for id, s := range r.seats {
			if now.Sub(s.lastSeen) > seatHold && r.game.canFree(id) {
				h.removeSeat(r, id)
			}
		}
		if len(r.seats) == 0 && !r.emptyAt.IsZero() && now.Sub(r.emptyAt) > idleRoom {
			h.endRoom(r)
		}
	}
}

// syncRooms：向玩聚查每個房間（被踢、重新開始、關房）。平台無法替遊戲伺服器斷線，所以要自己查。
func (h *hub) syncRooms(ctx context.Context) {
	h.mu.Lock()
	type ref struct {
		id    string
		epoch int
	}
	list := make([]ref, 0, len(h.rooms))
	for _, r := range h.rooms {
		list = append(list, ref{r.id, r.epoch})
	}
	h.mu.Unlock()
	for _, x := range list {
		m, err := h.pt.GetRoomMembers(ctx, x.id)
		var apiErr *playtogether.APIError
		gone := errors.As(err, &apiErr) && apiErr.Status == 404 // 房間已不存在
		if err != nil && !gone {
			log.Printf("查詢房間失敗（下次再試）：%v", err)
			h.mu.Lock()
			if h.syncFailingSince.IsZero() {
				h.syncFailingSince = h.now()
			}
			h.mu.Unlock()
			continue
		}
		h.mu.Lock()
		h.syncFailingSince = time.Time{}
		r := h.rooms[x.id]
		switch {
		case r == nil || r.epoch != x.epoch:
			// 查詢期間房間已經換了一局，下次再查
		case gone || !m.Open:
			h.endRoom(r)
		case m.Epoch > r.epoch:
			h.endRoom(r) // 房主重新開始：玩家的頁面會重新載入，用新的啟動碼開新局
		default:
			for _, mem := range m.Members {
				if mem.Kicked {
					h.removeSeat(r, mem.PlayerID)
				}
			}
		}
		h.mu.Unlock()
	}
}

// run 啟動背景工作：每秒整理座位、每 ROOM_SYNC 向玩聚查房間。
func (h *hub) run() {
	go func() {
		for range time.Tick(time.Second) {
			h.sweep()
		}
	}()
	go func() {
		for range time.Tick(roomSync) {
			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
			h.syncRooms(ctx)
			cancel()
		}
	}()
}

func envDuration(k string, def time.Duration) time.Duration {
	if v := os.Getenv(k); v != "" {
		if d, err := time.ParseDuration(v); err == nil && d > 0 {
			return d
		}
		log.Printf("%s 格式錯誤（例如 10s、1m），改用預設 %s", k, def)
	}
	return def
}

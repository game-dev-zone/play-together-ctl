// [[.Name]] 的遊戲伺服器（pt new 從範本「一起按」產生）：這個檔案只有遊戲規則。
//
// 和玩聚平台的接口（兌換啟動碼、座位與斷線重連、踢人、重新開始、關房、回報一局、限流、請求大小、跨來源、/healthz）
// 都在玩聚 SDK 的 gameserver 套件（third_party/playtogether-sdk-go/gameserver）；平台接口有新增或修正時，
// 在專案根目錄執行 pt sdk update 就會更新，不用改這個檔案。
//
// 本機開發：在專案根目錄執行 pt dev（本機假平台，不需要連玩聚）；改完用 pt verify server 驗證和玩聚的接口。
//
// 接上玩聚（正式部署）：
//
//	PT_API_URL=（平台網址） PT_KEY_ID=（伺服器金鑰 ID） PT_KEY_FILE=../keys/server.key \
//	ALLOW_ORIGINS='https://*.games.（平台網域）' ADDR=0.0.0.0:8090 go run .
//
// 選填：SEAT_HOLD（離線多久讓出座位，預設 60s）、ROOM_SYNC（多久向玩聚查一次房間，預設 10s）、
// TRUST_PROXY=<代理層數>（在反向代理後面時，限流改用 X-Forwarded-For 的 IP）。
//
// 規則：下面的函式都在套件的鎖裡依序執行，不需要自己加鎖；但只能做記憶體內的運算，
// 不能呼叫平台、不能等網路或檔案。回報一局用 r.StartRound、r.EndRound（套件在背景送出）。
package main

import (
	"context"
	"encoding/json"
	"log"
	"net/http"
	"os"
	"os/signal"
	"sort"
	"syscall"
	"time"

	playtogether "github.com/Yanghsuanming/play-together/sdk-go"
	"github.com/Yanghsuanming/play-together/sdk-go/gameserver"
)

const roundLength = 10 * time.Second

// game 是一個房間的遊戲狀態（「一起按」：10 秒內比誰按得多）。換成你的玩法時改這裡。
type game struct {
	taps   map[string]int // 玩家 ID → 按了幾下
	endsAt time.Time      // 進行中的一局何時結束；零值表示沒有在玩
	winner string
}

func newGame(*gameserver.Room) gameserver.Game { return &game{taps: map[string]int{}} }

func (g *game) playing(now time.Time) bool { return !g.endsAt.IsZero() && now.Before(g.endsAt) }

// CanFree：離線太久的人能不能讓出座位。一局進行中先保留，讓他有機會回來。
func (g *game) CanFree(playerID string) bool { return g.endsAt.IsZero() }

// Leave：玩家讓出座位或被房主踢出。
func (g *game) Leave(playerID string) { delete(g.taps, playerID) }

// Close：房間結束（房主重新開始、關房）。進行中的一局由套件回報「中止」，這裡只清理。
func (g *game) Close() { g.endsAt = time.Time{} }

type playerView struct {
	ID     string `json:"id"`
	Name   string `json:"name"`
	Taps   int    `json:"taps"`
	Online bool   `json:"online"`
}

// View：給某一位玩家看的完整狀態（加入、重新連線、每次操作後都回這個）。只放這位玩家可以看的資料。
func (g *game) View(r *gameserver.Room, viewer string) any {
	seats := r.Seats()
	list := make([]playerView, 0, len(seats))
	for _, s := range seats {
		list = append(list, playerView{ID: s.PlayerID, Name: s.Name, Taps: g.taps[s.PlayerID], Online: s.Online})
	}
	sort.Slice(list, func(i, j int) bool {
		return list[i].Taps > list[j].Taps || (list[i].Taps == list[j].Taps && list[i].Name < list[j].Name)
	})
	left := 0.0
	if now := r.Now(); g.playing(now) {
		left = g.endsAt.Sub(now).Seconds()
	}
	return map[string]any{"me": viewer, "players": list, "playing": left > 0, "secondsLeft": left, "winner": g.winner}
}

// Tick：每 200ms 呼叫一次。時間到就結束這一局、判定勝負。
func (g *game) Tick(r *gameserver.Room) {
	if g.endsAt.IsZero() || r.Now().Before(g.endsAt) {
		return
	}
	best := 0
	for _, s := range r.Seats() {
		if n := g.taps[s.PlayerID]; n > best {
			best, g.winner = n, s.Name
		}
	}
	g.endsAt = time.Time{}
	r.EndRound(playtogether.RoundCompleted)
}

// onAction：玩家送來的操作（POST /action 的 action，data 是選用的 JSON）。玩家只能送「操作」，分數與勝負由伺服器決定。
// 不認得的 action（例如前端每 0.5 秒輪詢用的 "state"）直接回 nil，套件會回這位玩家的 View。
func onAction(r *gameserver.Room, seat gameserver.Seat, gg gameserver.Game, action string, data json.RawMessage) error {
	g := gg.(*game)
	now := r.Now()
	switch action {
	case "start":
		if !g.endsAt.IsZero() {
			return nil
		}
		ids := []string{}
		for _, s := range r.Seats() {
			g.taps[s.PlayerID] = 0
			ids = append(ids, s.PlayerID)
		}
		if _, err := r.StartRound(ids); err != nil {
			return &gameserver.ActionError{Code: err.Error()}
		}
		g.winner, g.endsAt = "", now.Add(roundLength)
	case "tap":
		if g.playing(now) {
			g.taps[seat.PlayerID]++
		}
	}
	return nil
}

func main() {
	pt, err := gameserver.PlatformFromEnv()
	if err != nil {
		log.Fatal(err)
	}
	s := gameserver.New(gameserver.Config{Platform: pt, NewGame: newGame, OnAction: onAction})
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	go s.Run(ctx)

	// 本機開發時也直接提供前端（同一個來源）；上傳到玩聚託管後，前端由玩聚提供、只呼叫 API
	static := http.FileServer(http.Dir(envOr("WEB_DIR", "../web")))
	addr := envOr("ADDR", "127.0.0.1:8090")
	srv := &http.Server{
		Addr:    addr,
		Handler: s.Handler(static),
		// 公開部署的基本防護：慢速傳送標頭或內容、不讀回應的連線不能一直佔著
		ReadHeaderTimeout: 10 * time.Second,
		ReadTimeout:       15 * time.Second,
		WriteTimeout:      30 * time.Second, // 平台兌換啟動碼最多約 10 秒
		IdleTimeout:       60 * time.Second,
		MaxHeaderBytes:    16 << 10,
	}
	done := make(chan struct{})
	go func() {
		defer close(done)
		<-ctx.Done()
		shutdown, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = srv.Shutdown(shutdown)
		s.Close(shutdown) // 送完還沒送出的一局回報
	}()
	log.Printf("[[.Name]]：http://%s（平台：%s）", addr, map[bool]string{true: "模擬模式", false: pt.BaseURL}[pt.Mock])
	if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
		log.Fatal(err)
	}
	<-done
}

func envOr(k, def string) string {
	if v := os.Getenv(k); v != "" {
		return v
	}
	return def
}

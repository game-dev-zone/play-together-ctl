	playtogether "github.com/Yanghsuanming/play-together/sdk-go" // 在 third_party/playtogether-sdk-go（pt sdk update 更新）
)

const roundLength = 10 * time.Second

// maxBody 是每個請求內容的上限；超過回 413。玩家只送操作，不需要很大。
const maxBody = 1024

// game 是一個房間的遊戲狀態（「一起按」：10 秒內比誰按得多）。換成你的玩法時改這裡。
type game struct {
	taps    map[string]int // 玩家 ID → 按了幾下
	endsAt  time.Time      // 進行中的一局何時結束；零值表示沒有在玩
	roundID string
	winner  string
}

func newGame() *game { return &game{taps: map[string]int{}} }

func (g *game) playing(now time.Time) bool { return !g.endsAt.IsZero() && now.Before(g.endsAt) }

// canFree：離線太久的人能不能讓出座位。一局進行中先保留，讓他有機會回來。
func (g *game) canFree(playerID string) bool { return g.endsAt.IsZero() }

// leave：玩家讓出座位或被房主踢出。
func (g *game) leave(playerID string) { delete(g.taps, playerID) }

// abort：房間結束（房主重新開始、關房）時呼叫；有進行中的一局就回傳它的 ID，骨架會回報「中止」。
func (g *game) abort() string {
	if g.endsAt.IsZero() {
		return ""
	}
	g.endsAt = time.Time{}
	return g.roundID
}

type playerView struct {
	ID     string `json:"id"`
	Name   string `json:"name"`
	Taps   int    `json:"taps"`
	Online bool   `json:"online"`
}

// view：給某一位玩家看的完整狀態（重新連線後也是送這個）。只放這位玩家可以看的資料。
func (g *game) view(r *room, viewer string, now time.Time) map[string]any {
	list := make([]playerView, 0, len(r.seats))
	for _, s := range r.seats {
		list = append(list, playerView{ID: s.PlayerID, Name: s.Name, Taps: g.taps[s.PlayerID], Online: s.online(now)})
	}
	sort.Slice(list, func(i, j int) bool {
		return list[i].Taps > list[j].Taps || (list[i].Taps == list[j].Taps && list[i].Name < list[j].Name)
	})
	left := 0.0
	if g.playing(now) {
		left = g.endsAt.Sub(now).Seconds()
	}
	return map[string]any{"me": viewer, "players": list, "playing": left > 0, "secondsLeft": left, "winner": g.winner}
}

func (s *server) start(r *room) {
	g := r.game
	g.roundID, g.winner = newToken(), ""
	g.endsAt = s.hub.now().Add(roundLength)
	ids := []string{}
	for id := range r.seats {
		g.taps[id] = 0
		ids = append(ids, id)
	}
	roomID, epoch, roundID := r.id, r.epoch, g.roundID
	go func() {
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		if err := s.hub.pt.ReportRoundStart(ctx, roomID, epoch, roundID, ids); err != nil {
			log.Printf("回報一局開始失敗（不影響遊戲）：%v", err)
		}
	}()
}

// tick：時間到就結束這一局、判定勝負，並回報給玩聚（成效分析用，失敗不影響遊戲）。
func (s *server) tick() {
	s.hub.mu.Lock()
	defer s.hub.mu.Unlock()
	now := s.hub.now()
	for _, r := range s.hub.rooms {
		g := r.game
		if g.endsAt.IsZero() || now.Before(g.endsAt) {
			continue
		}
		best := 0
		for _, st := range r.seats {
			if n := g.taps[st.PlayerID]; n > best {
				best, g.winner = n, st.Name
			}
		}
		g.endsAt = time.Time{}
		roomID, epoch, roundID := r.id, r.epoch, g.roundID
		go func() {
			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
			defer cancel()
			if err := s.hub.pt.ReportRoundEnd(ctx, roomID, epoch, roundID, playtogether.RoundCompleted); err != nil {
				log.Printf("回報一局結束失敗（不影響遊戲）：%v", err)
			}
		}()
	}
}

type server struct{ hub *hub }

func main() {
	addr := envOr("ADDR", "127.0.0.1:8090")
	pt := &playtogether.Client{BaseURL: os.Getenv("PT_API_URL"), KeyID: os.Getenv("PT_KEY_ID"), Mock: os.Getenv("PT_MOCK") == "1"}
	if !pt.Mock {
		raw, err := os.ReadFile(envOr("PT_KEY_FILE", "../keys/server.key")) // pt keygen 產生的檔案：一行 base64 種子
		if err != nil {
			log.Fatalf("讀不到伺服器私鑰（PT_KEY_FILE）：%v", err)
		}
		seed, err := base64.StdEncoding.DecodeString(strings.TrimSpace(string(raw)))
		if err != nil || len(seed) != ed25519.SeedSize {
			log.Fatal("伺服器私鑰格式錯誤：請用 pt keygen 產生")
		}
		pt.PrivateKey = ed25519.NewKeyFromSeed(seed)
	}
	s := &server{hub: newHub(pt)}
	s.hub.run()
	go func() {
		for range time.Tick(200 * time.Millisecond) {
			s.tick()
		}
	}()

	mux := http.NewServeMux()
	// 本機開發時直接提供前端（同一個來源）；上傳到玩聚託管後，前端由玩聚提供、只呼叫下面的 API
	mux.Handle("GET /", http.FileServer(http.Dir(envOr("WEB_DIR", "../web"))))
	mux.HandleFunc("GET /healthz", healthz)
	// 第一次進入、重新整理、網路恢復後都走這裡：用新的啟動碼回到原座位
	mux.HandleFunc("POST /join", func(w http.ResponseWriter, r *http.Request) {
		var in struct{ LaunchCode string }
		if !readJSON(w, r, &in) {
			return
		}
		out, err := s.hub.join(r.Context(), in.LaunchCode)
		var apiErr *playtogether.APIError
		switch {
		case errors.As(err, &apiErr):
			writeError(w, http.StatusForbidden, apiErr.Code) // 啟動碼無效、過期、已用過，或被房主踢出
		case errors.Is(err, errStaleEpoch):
			writeError(w, http.StatusConflict, err.Error())
		case errors.Is(err, errPlatformStale):
			writeError(w, http.StatusServiceUnavailable, err.Error())
		case err != nil:
			log.Printf("兌換啟動碼失敗：%v", err)
			writeError(w, http.StatusBadGateway, "unavailable")
		default:
			writeJSON(w, http.StatusOK, out)
		}
	})
	// 其他操作都帶 join 拿到的 token；玩家只能送「操作」，分數與勝負由伺服器決定
	mux.HandleFunc("POST /action", func(w http.ResponseWriter, r *http.Request) {
		var in struct{ Token, Action string }
		if !readJSON(w, r, &in) {
			return
		}
		if !actionPerPlayer.allow(in.Token) {
			writeError(w, http.StatusTooManyRequests, "rate_limited")
			return
		}
		s.hub.mu.Lock()
		defer s.hub.mu.Unlock()
		rm, st, err := s.hub.lookup(in.Token)
		if err != nil {
			writeError(w, http.StatusUnauthorized, err.Error()) // 換了分頁或裝置、被踢、房間已結束
			return
		}
		now := s.hub.now()
		switch in.Action {
		case "start":
			if rm.game.endsAt.IsZero() {
				s.start(rm)
			}
		case "tap":
			if rm.game.playing(now) {
				rm.game.taps[st.PlayerID]++
			}
		}
		writeJSON(w, http.StatusOK, rm.game.view(rm, st.PlayerID, now))
	})

	allowed := strings.Split(os.Getenv("ALLOW_ORIGINS"), ",")
	log.Printf("[[.Name]]：http://%s（平台：%s）", addr, map[bool]string{true: "模擬模式", false: pt.BaseURL}[pt.Mock])
	log.Fatal(http.ListenAndServe(addr, cors(allowed, protect(mux))))
}

// cors：上傳到玩聚託管後，前端在 https://<版本>.games.（平台網域），和遊戲伺服器不同來源，要允許跨來源請求。
// 支援 https://*.games.example.com 這種萬用字元（每個版本的網址都不同）。
func cors(allowed []string, next http.Handler) http.Handler {
	match := func(origin string) bool {
		for _, a := range allowed {
			a = strings.TrimSpace(a)
			if a == "" {
				continue
			}
			if a == origin {
				return true
			}
			if scheme, rest, ok := strings.Cut(a, "://*."); ok && strings.HasPrefix(origin, scheme+"://") && strings.HasSuffix(origin, "."+rest) {
				return true
			}
		}
		return false
	}
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if o := r.Header.Get("Origin"); o != "" && match(o) {
			w.Header().Set("Access-Control-Allow-Origin", o)
			w.Header().Set("Access-Control-Allow-Headers", "Content-Type")
			w.Header().Set("Vary", "Origin")
			if r.Method == http.MethodOptions {
				w.WriteHeader(http.StatusNoContent)
				return
			}
		}
		next.ServeHTTP(w, r)
	})
}

// readJSON 讀取請求內容；太大回 413，格式錯誤（含 JSON 後面還有其他內容）回 400。
func readJSON(w http.ResponseWriter, r *http.Request, v any) bool {
	dec := json.NewDecoder(http.MaxBytesReader(w, r.Body, maxBody))
	err := dec.Decode(v)
	if err == nil {
		if _, extra := dec.Token(); extra != io.EOF {
			err = errors.Join(errors.New("JSON 後面還有其他內容"), extra)
		}
	}
	var tooLarge *http.MaxBytesError
	switch {
	case errors.As(err, &tooLarge):
		writeError(w, http.StatusRequestEntityTooLarge, "too_large")
	case err != nil:
		writeError(w, http.StatusBadRequest, "bad_request")
	default:
		return true
	}
	return false
}

func writeJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(v)
}

func writeError(w http.ResponseWriter, status int, code string) {
	writeJSON(w, status, map[string]string{"error": code})
}

func envOr(k, def string) string {
	if v := os.Getenv(k); v != "" {
		return v
	}
	return def
}

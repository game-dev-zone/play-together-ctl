; [[.Name]]：用 pt new -client godot 建立的玩聚遊戲（Godot 4）
config_version=5

[application]

config/name="[[.Name]]"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

PlayTogether="*res://addons/playtogether/playtogether.gd"

[display]

window/size/viewport_width=[[if eq .Orientation "landscape"]]844[[else]]390[[end]]
window/size/viewport_height=[[if eq .Orientation "landscape"]]390[[else]]844[[end]]
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 畫面方向（[[.OrientationLabel]]）：0 橫式、1 直式、6 跟著手機旋轉；改方向時也要改 playtogether.json 的 orientation
window/handheld/orientation=[[if eq .Orientation "landscape"]]0[[else if eq .Orientation "portrait"]]1[[else]]6[[end]]

[editor_plugins]

enabled=PackedStringArray("res://addons/playtogether/plugin.cfg")

[gui]

theme/custom_font="res://fonts/NotoSansTC-Common.otf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

# [[.Name]] 的常用指令（pt new 產生）。每個目標都只是包裝 pt 指令，不用 make 也可以直接執行。
# 用法：make（列出指令）、make dev、make verify（每次改完跑）、make upload VERSION=1.0.0 NOTES="第一個版本"

.DEFAULT_GOAL := help
.PHONY: help dev server[[if eq .Client "godot"]] build[[end]] test check verify keys upload[[if eq .Client "godot"]] clean[[end]]

PT ?= pt
VERSION ?=
NOTES ?=

help:
	@echo "make dev       本機開發（本機假平台與控制面板）：[[if eq .Client "godot"]]匯出 Godot 網頁版、[[end]]啟動[[if eq .GameServer "playtogether-managed"]]遊戲伺服器[[else]]參考伺服器[[end]]、打開[[if .Multiplayer]]兩個玩家分頁[[else]]一個玩家分頁[[end]]"
	@echo "make server    只啟動遊戲伺服器與本機假平台（不開瀏覽器）"[[if eq .Client "godot"]]
	@echo "make build     匯出 Godot 網頁版到 build/"[[end]]
	@echo "make test      遊戲伺服器的檢查與測試"
	@echo "make verify    啟動驗證：[[if eq .Client "godot"]]匯出、[[end]]伺服器測試、檢查要上傳的檔案、在模擬模式實際啟動一次[[if eq .GameServer "playtogether-managed"]]、用本機假平台驗證和玩聚的接口[[end]]（不需要金鑰）"
	@echo "make check     上傳前的完整檢查（[[if eq .GameServer "none"]]platform 要填好；此模式不需要 serverUrl[[else]]platform、serverUrl 都要填好[[end]]）"
	@echo "make keys      產生還沒有的金鑰（[[if eq .GameServer "none"]]keys/upload.key；不需要遊戲伺服器金鑰[[else]]keys/upload.key、keys/server.key[[end]]）；第一次上傳前通常用 pt register（會自動產生金鑰並登記）"
	@echo "make upload VERSION=1.0.0 NOTES=\"說明\"   上傳一個版本"[[if eq .Client "godot"]]
	@echo "make clean     刪除匯出結果 build/"[[end]]

dev:
	$(PT) dev

server:
	$(PT) dev -players 0
[[- if eq .Client "godot"]]

build:
	$(PT) build
[[- end]]

test:
[[- if eq .Server "go"]]
	cd server && go vet ./... && go test ./...
[[- else]]
	cd server && node --check main.mjs
[[- end]]

check:
	$(PT) check

verify: test
	$(PT) dev -smoke
[[- if eq .GameServer "playtogether-managed"]]
	$(PT) verify server
[[- end]]
	$(PT) check -local
	@echo "✓ 驗證通過；上傳前再跑 make check"

keys:
	@test -f keys/upload.key || $(PT) keygen -purpose upload
[[- if ne .GameServer "none"]]
	@test -f keys/server.key || $(PT) keygen -purpose server
[[- end]]

upload:
	@test -n "$(VERSION)" || { echo "請指定版本：make upload VERSION=1.0.0 NOTES=\"說明\""; exit 1; }
	$(PT) upload -version "$(VERSION)" -notes "$(NOTES)"
[[- if eq .Client "godot"]]

clean:
	rm -rf build
[[- end]]

* { box-sizing: border-box; }
body { margin: 0; font-family: system-ui, -apple-system, 'PingFang TC', 'Noto Sans TC', sans-serif; background: #fffaf2; color: #1d2140; }
main { max-width: 480px; margin: 0 auto; padding: 72px 16px 24px; text-align: center; } /* 上方留空間給平台的浮動按鈕 */
button { width: 100%; min-height: 64px; margin: 8px 0; border: 0; border-radius: 16px; font: inherit; font-size: 1.3rem; font-weight: 800; color: #fff; background: #d93a3a; touch-action: manipulation; }
#start { background: #1b6fdc; }
ol { text-align: left; font-size: 1.1rem; }
#rotate { display: none; }
[[- if ne .Orientation "portrait"]]

/* 橫拿時：左邊是按鈕，右邊是玩家列表 */
@media (orientation: landscape) {
  main { max-width: 880px; padding: 56px 24px 16px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; align-items: start; }
  main > * { grid-column: 1; }
  #players { grid-column: 2; grid-row: 1 / span 6; margin-top: 0; }
  h1 { margin: 0 0 8px; }
}
[[- end]]
[[- if eq .Orientation "landscape"]]

/* 這款遊戲是橫式：直拿時請玩家轉成橫式 */
@media (orientation: portrait) {
  #rotate { display: flex; position: fixed; inset: 0; z-index: 10; align-items: center; justify-content: center; padding: 32px; background: #1d2140; color: #fff; font-size: 1.4rem; font-weight: 800; text-align: center; }
}
[[- end]]
